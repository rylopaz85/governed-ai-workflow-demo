# Set values locally as environment variables. Never commit the real values.
WEBHOOK_SECRET=<generate-a-unique-random-secret-of-at-least-16-chars>
OPERATOR_TOKEN=<generate-a-second-unique-random-secret-of-at-least-16-chars>
WORKFLOW_DB_PATH=workflow-demo.sqlite3
AI_BACKEND=rules
# To use the optional live LLM, set AI_BACKEND=openai and configure both below.
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
